{
  "manifest_version": 3,
  "name": "Study Friction AI",
  "version": "0.1.0",
  "description": "Stop doomscrolling. Build focus. AI-powered attention management.",
  "permissions": ["storage", "tabs", "activeTab", "history"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.tiktok.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.reddit.com/*",
    "*://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["content/detector.js", "content/friction.js"],
      "css": ["content/friction.css"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
